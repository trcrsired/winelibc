;
; Import-library definition for winelibc_nt.dll — the NT-emulation side of the
; __wine_unix contract. Build the import library with:
;
;   llvm-dlltool -d def/winelibc_nt.def -D winelibc_nt.dll -l libwinelibc_nt.a
;
; The dll exports the same unixcall function table as the host unixlib
; (fast_io_wine.so). A PE binary calls entries[code](args) directly — no
; __wine_unix_call_dispatcher context switch is needed since everything lives
; in the same address space.
;
LIBRARY "winelibc_nt.dll"

EXPORTS
	__wine_unix_call_funcs	DATA
	__wine_unix_lib_init
